{
  "id": "mcp-test",
  "version": "1.0.0",
  "hubApi": 0,
  "name": "MCP test",
  "description": "Commands for the extension MCP tool tests",
  "provider": "CALM Hub tests",
  "routes": [
    { "id": "services", "method": "GET", "path": "/namespaces/{namespace}/services", "scope": "read" },
    { "id": "add-service", "method": "POST", "path": "/namespaces/{namespace}/services", "scope": "write" },
    { "id": "remove-service", "method": "DELETE", "path": "/namespaces/{namespace}/services/{name}", "scope": "write" },
    { "id": "service", "method": "GET", "path": "/services/{service}", "scope": "authenticated" },
    { "id": "service-admin", "method": "GET", "path": "/services/admin", "scope": "global_admin" },
    { "id": "search", "method": "POST", "path": "/search", "scope": "authenticated", "readOnly": true }
  ],
  "commands": {
    "get-service": {
      "route": "service",
      "description": "Get one service",
      "input": {
        "type": "object",
        "properties": { "service": { "type": "string" } },
        "required": ["service"]
      }
    },
    "search": {
      "route": "search",
      "description": "Search the services",
      "input": {
        "type": "object",
        "properties": { "text": { "type": "string" } },
        "required": ["text"]
      }
    },
    "list-services": {
      "route": "services",
      "description": "List the services that a namespace owns",
      "input": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1 },
          "tag": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["namespace"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "services": { "type": "array", "items": { "type": "string" } } }
      },
      "destructive": false,
      "idempotent": true
    },
    "add-service": {
      "route": "add-service",
      "description": "Record a service that a namespace owns",
      "input": {
        "type": "object",
        "properties": { "namespace": { "type": "string" }, "service": { "$ref": "#/$defs/service" } },
        "required": ["namespace", "service"],
        "$defs": {
          "service": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        }
      },
      "destructive": false
    },
    "service-names": {
      "route": "services",
      "description": "List the names of the services that a namespace owns",
      "input": {
        "type": "object",
        "properties": { "namespace": { "type": "string" } },
        "required": ["namespace"]
      },
      "output": {
        "$ref": "#/$defs/names",
        "$defs": {
          "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
          "name": { "type": "string" }
        }
      }
    },
    "remote-output": {
      "route": "search",
      "description": "Search with a result from a remote schema",
      "input": { "type": "object" },
      "output": { "type": "object", "properties": { "hits": { "$ref": "https://example.com/hits.json" } } }
    },
    "remote-search": {
      "route": "search",
      "description": "Search with a filter from a remote schema",
      "input": {
        "type": "object",
        "properties": { "filter": { "$ref": "https://example.com/filter.json" } }
      }
    },
    "remove-service": {
      "route": "remove-service",
      "description": "Remove a service from a namespace",
      "input": {
        "type": "object",
        "properties": { "namespace": { "type": "string" }, "name": { "type": "string" } },
        "required": ["namespace", "name"]
      },
      "destructive": true,
      "idempotent": true
    }
  }
}
